            className="block rounded-[18px] p-3 no-underline transition-all hover:border-[#7c5cff]/50"
            style={{
              background: "linear-gradient(150deg, rgba(124,92,255,0.14), rgba(124,92,255,0.03))",
              border: "1px solid rgba(255,255,255,0.08)",
