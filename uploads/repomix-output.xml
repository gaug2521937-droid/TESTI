// Расшифровка кодов погоды WMO
const WMO: Record<number, { text: string; icon: string }> = {
  0: { text: "Ясно", icon: "☀️" },
  1: { text: "Преимущественно ясно", icon: "🌤" },
  2: { text: "Переменная облачность", icon: "⛅" },
  3: { text: "Пасмурно", icon: "☁️" },
  45: { text: "Туман", icon: "🌫" },
