                <p className="text-[12px] text-[#9a9aa8] truncate">{current.artist}</p>
                <div className="hidden sm:flex items-center gap-1.5 mt-0.5">
                  <span
                    className="gash-badge !text-[9px] !px-1.5 !py-0 gash-badge-success"
