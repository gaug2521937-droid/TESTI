        <linearGradient id="lg-core" x1="16" y1="14" x2="34" y2="34">
          <stop offset="0%" stopColor="#22d3ee" />
          <stop offset="60%" stopColor="#7c5cff" />
          <stop offset="100%" stopColor="#f043a0" />
