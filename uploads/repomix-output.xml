            <span className="flex-1 font-mono text-[12.5px] text-[#dcdce6] break-all">{u}</span>
            <button onClick={() => onCopy(u, "UUID")} className="gash-btn-ghost flex-shrink-0">📋</button>
          </div>
        ))}
