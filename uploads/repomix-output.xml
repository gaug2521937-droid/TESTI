  userId: integer("user_id").references(() => users.id, { onDelete: "cascade" }),
  guestKey: varchar("guest_key", { length: 64 }),
  cityKey: varchar("city_key", { length: 80 }).notNull(),
  createdAt: timestamp("created_at").defaultNow().notNull(),
});
