"use client";

import { useState, useMemo, useEffect } from "react";

type ToolKey = "calc" | "units" | "date" | "password" | "qr" | "base64" | "count" | "color";

const TOOLS: { key: ToolKey; label: string; icon: string; desc: string; color: string }[] = [
