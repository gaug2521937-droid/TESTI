                )}
                <div className="flex-1 min-w-0">
                  <p className="text-[14px] font-extrabold text-[#e8e8f0] truncate">{p.name}</p>
                  <p className="text-[11.5px] text-[#6a6a7a]">
                    {p.trackCount} трек. · {dur(p.totalDuration)}
